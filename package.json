{
  "name": "arc-eval-lab",
  "version": "0.0.1",
  "description": "An open-source AI evaluation platform for datasets, model providers, evaluators, batch evaluation runs, metrics, and regression detection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "evaluation",
    "testing",
    "datasets",
    "llm",
    "metrics",
    "regression"
  ],
  "author": "azzaaniooo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amaanforshopify-prog/arc-eval-lab.git"
  },
  "bugs": {
    "url": "https://github.com/amaanforshopify-prog/arc-eval-lab/issues"
  },
  "homepage": "https://github.com/amaanforshopify-prog/arc-eval-lab#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
